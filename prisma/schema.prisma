// Prisma schema file for Garments Production Planning & Analytics

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ExcelImport {
  id               String                  @id @default(cuid())
  fileName         String
  originalFileName String
  fileSize         Int                     @default(0)
  uploadedAt       DateTime                @default(now())
  processedAt      DateTime?
  status           String                  @default("SUCCESS") // PENDING, PROCESSING, SUCCESS, FAILED
  totalSheets      Int                     @default(0)
  totalRows        Int                     @default(0)
  validRows        Int                     @default(0)
  invalidRows      Int                     @default(0)
  month            String?                 // e.g. "2026-10"
  dateKeys         String[]                // e.g. ["2026-10-01", ...]
  errorMessage     String?
  metadata         Json?

  rawRows          ExcelRawRow[]
  plans            ProductionPlan[]
  dailySAHs        LineDailySAH[]
  dailyMachineHrs  LineDailyMachineHour[]
  budgets          BudgetSummary[]
  validationErrors ImportValidationError[]

  @@map("excel_imports")
}

model ExcelRawRow {
  id        String      @id @default(cuid())
  importId  String
  sheetName String
  rowNumber Int
  rawData   Json
  createdAt DateTime    @default(now())

  import    ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([sheetName])
  @@map("excel_raw_rows")
}

model Unit {
  id         String                 @id @default(cuid())
  name       String                 // e.g. "B1 Unit-02"
  code       String                 @unique // e.g. "B1U2", "B1U3", "B1U4", "B2U2", "B2U3"
  group      String                 @default("B1") // "B1" or "B2"
  shiftHours Float                  @default(10.0)
  capacity   Int                    @default(0)
  active     Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  lines      Line[]
  plans      ProductionPlan[]
  dailySAHs  LineDailySAH[]
  dailyMachineHrs LineDailyMachineHour[]
  budgets    BudgetSummary[]

  @@map("units")
}

model Line {
  id         String                 @id @default(cuid())
  unitId     String
  lineName   String                 // e.g. "U02-01", "B2U2-05"
  manpower   Int                    @default(25)
  capacity   Int                    @default(1)
  active     Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  unit       Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plans      ProductionPlan[]
  dailySAHs  LineDailySAH[]
  dailyMachineHrs LineDailyMachineHour[]

  @@unique([unitId, lineName])
  @@index([unitId])
  @@index([lineName])
  @@map("lines")
}

model ProductionPlan {
  id        String                @id @default(cuid())
  importId  String
  unitId    String
  lineId    String?
  lineName  String?
  unitCode  String
  styleRef  String
  article   String?
  buyer     String
  type      String?
  smv       Float                 @default(0.0)
  orderQty  Int                   @default(0)
  planQty   Int                   @default(0)
  psd       DateTime?
  manpower  Int                   @default(25)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  import    ExcelImport           @relation(fields: [importId], references: [id], onDelete: Cascade)
  unit      Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  line      Line?                 @relation(fields: [lineId], references: [id], onDelete: SetNull)
  daily     ProductionPlanDaily[]

  @@index([importId])
  @@index([unitId])
  @@index([lineId])
  @@index([buyer])
  @@index([styleRef])
  @@index([article])
  @@map("production_plans")
}

model ProductionPlanDaily {
  id               String         @id @default(cuid())
  productionPlanId String
  date             DateTime
  dateString       String         // "YYYY-MM-DD"
  quantity         Int            @default(0)

  plan             ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)

  @@index([productionPlanId])
  @@index([dateString])
  @@index([date])
  @@map("production_plan_dailies")
}

model LineDailySAH {
  id         String      @id @default(cuid())
  importId   String
  unitId     String
  lineId     String?
  lineName   String
  date       DateTime
  dateString String      // "YYYY-MM-DD"
  sah        Float       @default(0.0)

  import     ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  line       Line?       @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@unique([importId, unitId, lineName, dateString])
  @@index([importId])
  @@index([unitId])
  @@index([lineId])
  @@index([dateString])
  @@map("line_daily_sahs")
}

model LineDailyMachineHour {
  id          String      @id @default(cuid())
  importId    String
  unitId      String
  lineId      String?
  lineName    String
  date        DateTime
  dateString  String      // "YYYY-MM-DD"
  machineHour Float       @default(0.0)

  import      ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  line        Line?       @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@unique([importId, unitId, lineName, dateString])
  @@index([importId])
  @@index([unitId])
  @@index([lineId])
  @@index([dateString])
  @@map("line_daily_machine_hours")
}

model BudgetSummary {
  id         String      @id @default(cuid())
  importId   String
  unitId     String
  planPCS    Float       @default(0.0)
  sah        Float       @default(0.0)
  clockHour  Float       @default(0.0)
  efficiency Float       @default(0.0)

  import     ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([importId, unitId])
  @@index([importId])
  @@index([unitId])
  @@map("budget_summaries")
}

model ImportValidationError {
  id         String      @id @default(cuid())
  importId   String
  sheetName  String
  rowNumber  Int
  columnName String?
  errorType  String
  message    String
  rawValue   String?
  createdAt  DateTime    @default(now())

  import     ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_validation_errors")
}
